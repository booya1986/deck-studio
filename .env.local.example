# Deck Studio settings. `pnpm wizard` writes .env.local for you; copy this file to
# .env.local only if you prefer to do it by hand. .env.local is ignored by git.

# How Deck Studio reaches Claude. Choose one:
#  - Leave this empty to use the Claude Code sign-in on this machine (a Claude Pro or Max subscription).
#  - Or set an API key from https://console.anthropic.com (billed per use).
# ANTHROPIC_API_KEY=

# Port for `pnpm studio`. Default 3000; the next free port is used when it is busy.
# PORT=3000
